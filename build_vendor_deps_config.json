{
  "description": "Input-owned vendor source builds using Premake and Make",
  "dependency_defaults": {
    "macos": {
      "deployment_target": "15.7"
    }
  },
  "vendor_sources": {
    "utf8proc": {
      "url": "https://github.com/JuliaStrings/utf8proc.git",
      "revision": "b3e0f28adaec943ac25e3e27514dd6037e7a022e",
      "version_file": "utf8proc.h",
      "version_prefix": "UTF8PROC_VERSION",
      "packages": [
        {
          "name": "libutf8proc",
          "description": "UTF8 processing",
          "library": "utf8proc",
          "cflags": [
            "-DUTF8PROC_STATIC"
          ]
        }
      ]
    },
    "brotli": {
      "url": "https://github.com/google/brotli.git",
      "revision": "5fa73e23bee34f84148719576a7a434f0fc43dc8",
      "version_file": "c/common/version.h",
      "version_prefix": "BROTLI_VERSION",
      "packages": [
        {
          "name": "libbrotlicommon",
          "description": "Brotli common library",
          "library": "brotlicommon",
          "libs_private": [
            "-lm"
          ]
        },
        {
          "name": "libbrotlidec",
          "description": "Brotli decoder library",
          "library": "brotlidec",
          "requires_private": [
            "libbrotlicommon"
          ]
        },
        {
          "name": "libbrotlienc",
          "description": "Brotli encoder library",
          "library": "brotlienc",
          "requires_private": [
            "libbrotlicommon"
          ]
        }
      ]
    },
    "thorvg": {
      "url": "https://github.com/thorvg/thorvg.git",
      "revision": "54a98e42813a84d3ac2314b818725f9eea8b1658",
      "version_file": "meson.build",
      "version_pattern": "version\\s*:\\s*'([^']+)'",
      "packages": [
        {
          "name": "thorvg",
          "description": "ThorVG vector graphics",
          "library": "thorvg",
          "requires": [
            "libpng",
            "libturbojpeg"
          ],
          "libs": [
            "-lpthread"
          ]
        }
      ]
    }
  },
  "dependency_builds": {
    "utf8proc": {
      "source_dir": "build_temp/utf8proc",
      "projects": [
        {
          "name": "utf8proc",
          "lang": "c17",
          "source_files": [
            "${source}/utf8proc.c"
          ],
          "includes": [
            "${source}"
          ],
          "defines": [
            "UTF8PROC_STATIC"
          ],
          "install_archive": "lib/libutf8proc.a"
        }
      ],
      "install_files": [
        {
          "source": "${source}/utf8proc.h",
          "destination": "include/utf8proc.h",
          "directory": false
        }
      ]
    },
    "brotli": {
      "source_dir": "mac-deps/brotli",
      "projects": [
        {
          "name": "brotlicommon",
          "lang": "c17",
          "source_files": [],
          "includes": [
            "${source}/c/include"
          ],
          "defines": [],
          "install_archive": "lib/libbrotlicommon.a",
          "source_patterns": [
            "${source}/c/common/*.c"
          ]
        },
        {
          "name": "brotlidec",
          "lang": "c17",
          "source_files": [],
          "includes": [
            "${source}/c/include"
          ],
          "defines": [],
          "install_archive": "lib/libbrotlidec.a",
          "source_patterns": [
            "${source}/c/dec/*.c"
          ]
        },
        {
          "name": "brotlienc",
          "lang": "c17",
          "source_files": [],
          "includes": [
            "${source}/c/include"
          ],
          "defines": [],
          "install_archive": "lib/libbrotlienc.a",
          "source_patterns": [
            "${source}/c/enc/*.c"
          ]
        }
      ],
      "install_files": [
        {
          "source": "${source}/c/include/brotli",
          "destination": "include/brotli",
          "directory": false
        }
      ]
    },
